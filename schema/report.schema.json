{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tryout Radar daily report",
  "type": "object",
  "required": ["date", "items"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generatedAt": { "type": "string", "description": "Local time with offset, e.g. 2026-10-24T12:08:00+02:00" },
    "headline": { "type": "string" },
    "sources": {
      "type": "object",
      "properties": {
        "github": { "type": "integer", "minimum": 0 },
        "x": { "type": "integer", "minimum": 0 },
        "xMode": { "enum": ["search", "browser", "off"] }
      }
    },
    "picks": { "type": "array", "items": { "type": "string" }, "maxItems": 5 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "source", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" },
          "title": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://" },
          "source": { "enum": ["github", "x", "web"] },
          "author": { "type": "string" },
          "stars": { "type": "integer", "minimum": 0 },
          "starsDelta": { "type": "integer", "minimum": 0 },
          "published": { "type": "string" },
          "category": { "type": "string", "description": "A topic key from config.toml, or 'other'" },
          "summary": { "type": "string" },
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "fit", "how"],
              "properties": {
                "key": { "type": "string", "description": "A project key from config.toml" },
                "fit": { "type": "integer", "minimum": 1, "maximum": 3 },
                "how": { "type": "string" }
              }
            }
          },
          "effort": { "type": "string" },
          "verdict": { "enum": ["try", "save", "watch"] },
          "caution": { "type": "string" },
          "verified": { "type": "boolean" }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "detail"],
        "properties": {
          "tool": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "cards"],
        "properties": {
          "title": { "type": "string" },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "detail"],
              "properties": {
                "label": { "type": "string" },
                "title": { "type": "string" },
                "detail": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "newProjects": {
      "type": "array",
      "description": "Projects the scout discovered and added today (see `tryout_radar project add`)",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
          "parent": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "engine": {
      "type": "object",
      "description": "Written by API mode (`tryout_radar scout`): which model judged and how much it read",
      "properties": {
        "mode": { "enum": ["api"] },
        "model": { "type": "string" },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "integer", "minimum": 0 },
        "judged": { "type": "integer", "minimum": 0 },
        "seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
